{
  "extends": "@repo/typescript-config/base.json",

  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,

    "types": ["bun", "node"],

    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",

    "outDir": "./dist"
  },
  "include": ["src", "drizzle.config.ts"],
  "exclude": ["node_modules", "dist"]
}
