{
  "name": "bun-mono",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "env:generate": "bun -e \"import { existsSync, copyFileSync } from 'fs'; if (!existsSync('.env')) copyFileSync('.env.example', '.env');\"",
    "build": "turbo run build",
    "dev": "bun run env:generate && turbo run dev",
    "dev:clean": "bun run clean && bun i && bun run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "clean": "rm -rf node_modules dist .turbo .vercel && bun --filter '*' clean",
    "check-types": "turbo run check-types",
    "db:generate": "bun run --filter api db:generate",
    "db:migrate": "bun run --filter api db:migrate",
    "db:push": "bun run --filter api db:push",
    "db:studio": "bun run --filter api db:studio"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "turbo": "^2.8.10",
    "typescript": "5.9.2",
    "tailwindcss": "^4.2.1",
    "@tailwindcss/postcss": "^4.2.1"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/configs/*"
  ]
}
